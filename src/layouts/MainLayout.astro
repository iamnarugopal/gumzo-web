---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Gumzo | Chat Online, Meet New People & Make Friends",
  description = "Join Gumzo to chat live, meet new people, make friends, and connect with communities online. Enjoy real-time conversations and discover new connections."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />
    <meta name="theme-color" content="#0A0714" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=DM+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>

  <body class="min-h-screen flex flex-col">

    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

  </body>
</html>