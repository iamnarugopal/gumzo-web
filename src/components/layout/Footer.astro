
---
const playStoreUrl = "https://play.google.com/store/apps/details?id=com.gumzo.chat";

const policyLinks = [
  { label: "Terms of Service", href: "/terms" },
  { label: "Privacy Policy", href: "/privacy" },
  { label: "Community Guidelines", href: "/guidelines" },
  { label: "Safety & Security", href: "/safety" },
  { label: "Law Enforcement Requests", href: "/law-enforcement" },
  { label: "Contact Support", href: "/support" },
  { label: "Delete Account", href: "/delete-account" },
];
---

<footer class="bg-dark-3">

  <!-- Download Section -->
  <section
    id="download"
    class="border-t border-white/5 px-5 py-16 text-center sm:py-20"
  >
    <div class="mx-auto max-w-4xl">

      <span class="mb-4 inline-block text-xs font-semibold uppercase tracking-[3px] text-primary-light">
        Your next conversation awaits
      </span>

      <h2 class="text-4xl text-white sm:text-5xl md:text-6xl">
        Ready to join Gumzo?
      </h2>

      <p class="mx-auto mt-6 max-w-3xl text-sm leading-7 text-gray-400 sm:text-base">
        Discover new communities, meet interesting people and
        enjoy conversations that bring people closer.
        Download Gumzo and find your place in the community.
      </p>

      <!-- Google Play -->
      <div class="mt-9 flex justify-center">
        <a
          href={playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Get Gumzo on Google Play"
          class="group inline-flex items-center transition duration-300 hover:-translate-y-1"
        >
          <img
            src="/GetItOnGooglePlay.svg"
            alt="Get it on Google Play"
            width="270"
            height="80"
            class="h-12 w-auto object-contain sm:h-20"
          />
        </a>
      </div>

    </div>
  </section>

  <!-- Bottom Footer Navigation -->
  <section class="border-t border-white/10 bg-dark-2">

    <div class="mx-auto max-w-7xl px-5 py-7 lg:px-8">

      <!-- Policy Links -->
      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-3">

          {policyLinks.map((link, index) => (
            <li class="flex items-center gap-4">
              <a
                href={link.href}
                class="text-xs text-gray-400 transition hover:text-primary-light sm:text-sm"
              >
                {link.label}
              </a>

              {index !== policyLinks.length - 1 && (
                <span
                  class="h-5 w-px bg-white/20"
                  aria-hidden="true"
                ></span>
              )}
            </li>
          ))}

        </ul>
      </nav>

      <!-- Copyright -->
      <div class="mt-8 text-center">
        <p class="text-sm text-gray-400">
          <span class="font-semibold text-gray-300">Gumzo</span>
          © {new Date().getFullYear()}. All rights reserved.
        </p>
      </div>

    </div>

  </section>

  <!-- Back to Top -->
  <button
    id="back-to-top"
    type="button"
    aria-label="Back to top"
    aria-hidden="true"
    tabindex="-1"
    class="invisible pointer-events-none fixed bottom-5 right-5 z-40 flex size-11 translate-y-3 items-center justify-center rounded-lg border border-white/10 bg-dark-1 text-xl text-white opacity-0 shadow-lg transition-all duration-300 hover:bg-primary"
  >
    ↑
  </button>

</footer>

<script>
  const backToTop =
    document.querySelector<HTMLButtonElement>("#back-to-top");

  const SCROLL_THRESHOLD = 150;

  const toggleBackToTop = () => {
    if (!backToTop) return;

    const shouldShow = window.scrollY > SCROLL_THRESHOLD;

    backToTop.classList.toggle("opacity-0", !shouldShow);
    backToTop.classList.toggle("opacity-100", shouldShow);

    backToTop.classList.toggle("invisible", !shouldShow);
    backToTop.classList.toggle("visible", shouldShow);

    backToTop.classList.toggle("pointer-events-none", !shouldShow);
    backToTop.classList.toggle("pointer-events-auto", shouldShow);

    backToTop.classList.toggle("translate-y-3", !shouldShow);
    backToTop.classList.toggle("translate-y-0", shouldShow);

    backToTop.setAttribute("aria-hidden", String(!shouldShow));
    backToTop.tabIndex = shouldShow ? 0 : -1;
  };

  // Set initial visibility
  toggleBackToTop();

  // Update visibility on scroll
  window.addEventListener("scroll", toggleBackToTop, {
    passive: true,
  });

  // Scroll smoothly to top
  backToTop?.addEventListener("click", () => {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  });
</script>
