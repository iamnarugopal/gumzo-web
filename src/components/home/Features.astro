---
import { FaUserCircle, FaUserFriends, FaUserLock } from "react-icons/fa";
import { IoChatbubbleEllipsesSharp } from "react-icons/io5";
import { MdMarkUnreadChatAlt } from "react-icons/md";
import { RiUser3Fill } from "react-icons/ri";
const leftFeatures = [
  {
    icon: "chat",
    title: "Live Room Conversations",
    description:
      "Join public chat rooms, meet new people and enjoy conversations with members from different communities.",
  },
  {
    icon: "message",
    title: "Private Messaging",
    description:
      "Take conversations beyond public rooms. Send private messages and connect one-on-one.",
  },
  {
    icon: "users",
    title: "Floating Avatars",
    description:
      "See who's in the room through interactive floating avatars that bring conversations to life.",
  },
];

const rightFeatures = [
  {
    icon: "profile",
    title: "Personal Profiles",
    description:
      "Create your own identity, customize your avatar and let others discover more about you.",
  },
  {
    icon: "friend",
    title: "Friend Connections",
    description:
      "Connect with people you enjoy talking to and build meaningful friendships on Gumzo.",
  },
  {
    icon: "privacy",
    title: "Privacy Controls",
    description:
      "Manage your online visibility and messaging preferences to stay in control of your experience.",
  },
];
---

<section id="features" class="relative overflow-hidden bg-dark-3 px-5 py-24 lg:px-8">

  <!-- Background glow -->
  <div class="pointer-events-none absolute left-1/2 top-1/2 z-0 size-125 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/10 blur-[130px]"></div>

  <div class="relative mx-auto max-w-7xl">

    <!-- Section Heading -->
    <div class="mx-auto mb-16 max-w-2xl text-center">

      <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-primary">
        ✦ Discover Gumzo
      </span>

      <h2 class="mt-6 text-4xl leading-tight text-white sm:text-5xl">
        Everything you need to connect.
      </h2>

      <p class="mt-5 text-sm leading-7 text-gray-400 sm:text-base">
        From lively public rooms to personal conversations,
        Gumzo gives you more ways to meet, connect and express yourself.
      </p>

    </div>

    <!-- Three Column Layout -->
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.8fr_1fr] lg:gap-10">

      <!-- LEFT FEATURES -->
      <div class="order-2 flex flex-col gap-10 lg:order-1">

        {leftFeatures.map((feature) => (
          <article class="group flex gap-4">

            <div class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition duration-300 group-hover:scale-110 group-hover:bg-primary/20">

              {feature.icon === "chat" && (
                <IoChatbubbleEllipsesSharp />
              )}

              {feature.icon === "message" && (
                <MdMarkUnreadChatAlt />
              )}

              {feature.icon === "users" && (
                <FaUserCircle />
              )}

            </div>

            <div>
              <h3 class="text-lg leading-snug text-white transition group-hover:text-primary sm:text-xl">
                {feature.title}
              </h3>

              <p class="mt-3 text-sm leading-7 text-gray-400">
                {feature.description}
              </p>
            </div>

          </article>
        ))}

      </div>

      <!-- CENTER APP PREVIEW -->
      <div class="order-1 relative mx-auto w-full max-w-137.5 lg:order-2">

        <!-- Glow -->
        <div class="absolute inset-10 rounded-full bg-primary/20 blur-[90px]"></div>

        <!-- Main App Window -->
        <div class="relative overflow-hidden rounded-2xl border border-white/20 bg-dark-1 p-3 shadow-2xl shadow-black/50 sm:rounded-3xl sm:p-4">

          <!-- Window Header -->
          <div class="flex items-center justify-between border-b border-white/10 px-2 pb-4">

            <div class="flex items-center gap-2">
              <img src="/logo-light.svg" alt="Gumzo" class="h-7 w-auto" />
            </div>

            <div class="flex items-center gap-2 rounded-full bg-success/10 px-3 py-1.5">
              <span class="size-2 rounded-full bg-success"></span>
              <span class="text-[10px] font-semibold text-success sm:text-xs">LIVE</span>
            </div>

          </div>

          <!-- Room Header -->
          <div class="px-2 pt-5">
            <div class="flex items-center justify-between">

              <div>
                <span class="text-[10px] uppercase tracking-widest text-primary sm:text-xs">
                  Public Room
                </span>

                <h3 class="mt-1 text-xl text-white sm:text-2xl">
                  General Chat
                </h3>
              </div>

              <div class="rounded-xl border border-white/10 bg-white/5 px-3 py-2">
                <p class="text-center text-sm font-semibold text-white">12</p>
                <p class="text-[9px] text-gray-400">Members</p>
              </div>

            </div>
          </div>

          <!-- Chat Messages -->
          <div class="mt-5 space-y-4 rounded-xl bg-dark-3/80 p-4 sm:p-5">

            <div class="flex items-start gap-3">
              <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary/20 text-xs font-bold text-primary">A</div>
              <div>
                <p class="text-xs font-semibold text-primary">Alex</p>
                <p class="mt-1 text-xs leading-5 text-gray-300">Hey everyone! What's happening today? 👋</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-secondary/20 text-xs font-bold text-secondary">R</div>
              <div>
                <p class="text-xs font-semibold text-secondary">Rahul</p>
                <p class="mt-1 text-xs leading-5 text-gray-300">Just joined this room. Happy to be here!</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-accent/20 text-xs font-bold text-pink-400">S</div>
              <div>
                <p class="text-xs font-semibold text-pink-400">Sarah</p>
                <p class="mt-1 text-xs leading-5 text-gray-300">Welcome! Let's have a great conversation ✨</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-success/20 text-xs font-bold text-success">M</div>
              <div>
                <p class="text-xs font-semibold text-success">Mike</p>
                <p class="mt-1 text-xs leading-5 text-gray-300">This is such a cool community!</p>
              </div>
            </div>

          </div>

          <!-- Floating Avatars -->
          <div class="mt-5 rounded-xl border border-white/10 bg-dark-3 p-4 sm:p-5">

            <div class="flex items-center justify-between">
              <p class="text-xs font-semibold text-white sm:text-sm">
                People in this room
              </p>
              <span class="text-[10px] text-primary sm:text-xs">
                Meet the community
              </span>
            </div>

            <div class="mt-5 flex items-center justify-center gap-2 sm:gap-4">

              <div class="flex size-10 items-center justify-center rounded-full border-2 border-primary bg-primary/20 text-sm font-bold text-white sm:size-12">A</div>

              <div class="flex size-12 items-center justify-center rounded-full border-2 border-secondary bg-secondary/20 text-base font-bold text-white sm:size-14">R</div>

              <div class="flex size-16 items-center justify-center rounded-full border-2 border-primary bg-linear-to-br from-primary to-secondary text-xl font-bold text-white shadow-lg shadow-primary/20 sm:size-19">S</div>

              <div class="flex size-12 items-center justify-center rounded-full border-2 border-accent bg-accent/20 text-base font-bold text-white sm:size-14">M</div>

              <div class="flex size-10 items-center justify-center rounded-full border-2 border-white/20 bg-white/10 text-xs font-bold text-white sm:size-12">+8</div>

            </div>

          </div>

          <!-- Message Input Preview -->
          <div class="mt-4 flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3">
            <span class="flex-1 text-xs text-gray-500">Type a message...</span>
            <span class="flex size-8 items-center justify-center rounded-lg bg-primary text-sm text-white">➤</span>
          </div>

        </div>

        <!-- Floating decoration -->
        <div class="absolute -left-5 top-24 hidden items-center gap-2 rounded-xl border border-white/10 bg-dark-1 px-3 py-3 shadow-xl sm:flex lg:-left-9">
          <span class="size-2 rounded-full bg-success"></span>
          <span class="text-xs font-medium text-white">Live conversations</span>
        </div>

        <div class="absolute -right-4 bottom-20 hidden items-center gap-2 rounded-xl border border-white/10 bg-dark-1 px-3 py-3 shadow-xl sm:flex lg:-right-8">
          <span class="text-lg">✨</span>
          <span class="text-xs font-medium text-white">Your community</span>
        </div>

      </div>

      <!-- RIGHT FEATURES -->
      <div class="order-3 flex flex-col gap-10">

        {rightFeatures.map((feature) => (
          <article class="group flex gap-4">

            <div class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition duration-300 group-hover:scale-110 group-hover:bg-primary/20">

              {feature.icon === "profile" && (
                <RiUser3Fill />
              )}

              {feature.icon === "friend" && (
                <FaUserFriends />
              )}

              {feature.icon === "privacy" && (
                <FaUserLock />
              )}

            </div>

            <div>
              <h3 class="text-lg leading-snug text-white transition group-hover:text-primary sm:text-xl">
                {feature.title}
              </h3>

              <p class="mt-3 text-sm leading-7 text-gray-400">
                {feature.description}
              </p>
            </div>

          </article>
        ))}

      </div>

    </div>

  </div>
</section>
