
---
import { LuLifeBuoy, LuMail } from "react-icons/lu";
import SupportForm from "../components/support/SupportForm";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Gumzo | Contact Support & Get Help"
  description="Need help with Gumzo? Contact our support team for assistance with your account, chat rooms, messaging, technical issues, or other questions about using Gumzo."
>
  <section class="relative isolate min-h-screen overflow-hidden bg-dark-3 px-4 py-12 sm:px-6 sm:py-16">

    <!-- Background Effects -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 size-[500px] -translate-x-1/2 rounded-full bg-primary/10 blur-[130px]"></div>

    <div class="pointer-events-none absolute -bottom-40 -right-40 -z-10 size-[400px] rounded-full bg-secondary/10 blur-[120px]"></div>

    <div class="mx-auto max-w-2xl">

      <!-- Page Heading -->
      <div class="mb-9 text-center">

        <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-primary-light">
          <LuLifeBuoy size={15} />
          We're here to help
        </span>

        <h1 class="mt-6 text-4xl leading-tight text-white sm:text-5xl">
          How can we help <span class="text-primary">you?</span>
        </h1>

        <p class="mx-auto mt-5 max-w-lg text-sm leading-7 text-gray-400 sm:text-base">
          Have a question, found a bug or want to share an idea?
          Send us a message and our team will look into it.
        </p>

      </div>

      <!-- React Support Form -->
      <SupportForm client:load />

      <!-- Email option for people without the app -->
      <div class="mt-8 rounded-2xl border border-primary/25 bg-primary/10 p-5 text-center sm:p-6">
        <div class="mx-auto mb-3 flex size-11 items-center justify-center rounded-xl bg-primary/15 text-primary-light">
          <LuMail size={22} />
        </div>
        <h2 class="text-base font-semibold text-white sm:text-lg">
          Don't use the Gumzo app?
        </h2>
        <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-300">
          If you don't have a Gumzo account or can't use the app, you can still reach us by email with any question or query.
        </p>
        <a
          href="mailto:gumzo.support@gmail.com"
          class="mt-4 inline-block break-all text-sm font-semibold text-primary-light hover:underline sm:text-base"
        >
          gumzo.support@gmail.com
        </a>
      </div>

    </div>
  </section>
</MainLayout>
