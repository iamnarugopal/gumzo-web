
---
import { LuFlag, LuShieldCheck } from "react-icons/lu";
import ReportForm from "../components/report/ReportForm";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Gumzo | Report a User"
  description="Report inappropriate content, abusive behaviour, suspicious activity, or other issues on Gumzo. Help us maintain a safe and respectful community."
>
  <main class="relative isolate min-h-screen overflow-hidden bg-dark-3 px-5 py-16 sm:py-20">
    <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 size-[500px] -translate-x-1/2 rounded-full bg-primary/10 blur-[130px]"></div>

    <div class="mx-auto max-w-2xl">
      {/* Page heading */}
      <div class="mb-8 text-center">
        <div class="mx-auto mb-6 flex size-16 items-center justify-center rounded-2xl border border-primary/25 bg-primary/10 text-primary">
          <LuFlag size={32} />
        </div>

        <span class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/10 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-primary">
          <LuShieldCheck size={14} />
          Trust & Safety
        </span>

        <h1 class="mt-6 text-4xl leading-tight text-white sm:text-5xl">
          Help Keep Gumzo <span class="text-primary">Safe</span>
        </h1>

        <p class="mt-5 text-sm leading-7 text-gray-400 sm:text-base">
          Why can't we all be respectful? Help our moderation team
          maintain a friendly community by reporting users who
          violate our Community Guidelines. You can report someone
          directly in Gumzo or use the form below.
        </p>

        <p class="mt-4 text-sm leading-7 text-gray-400">
          Need assistance? Visit our{" "}
          <a href="/support" class="font-semibold text-primary hover:underline">
            Help & Feedback
          </a>
          {" "}page to contact our team.
        </p>

        <p class="mt-3 text-sm leading-7 text-gray-400">
          Interested in becoming a moderator? Learn more about our{" "}
          <a href="/mod" class="font-semibold text-primary hover:underline">
            Moderator Programme
          </a>
          .
        </p>

        <p class="mt-4 text-xs leading-6 text-gray-500">
          Before submitting a report, please read our{" "}
          <a
            href="/guidelines"
            class="font-semibold text-primary hover:underline"
          >
            Community Guidelines
          </a>
          {" "}to understand what behaviour should be reported.
        </p>
      </div>

      <ReportForm client:load />
    </div>
  </main>
</MainLayout>
