# Copy to .env for local dev. In production, set these in Vercel
# (Project Settings -> Environment Variables) and redeploy.

# --- Server-only (used by src/pages/api/* via src/lib/supabaseProxy.ts) ---
# Never prefix with PUBLIC_: these must not reach the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# --- reCAPTCHA v3 ---
# Site key is public (loaded in the browser).
PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key is verified server-side (also set it in Supabase function secrets).
RECAPTCHA_SECRET_KEY=
